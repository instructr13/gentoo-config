Guard the <sys/cdefs.h> include so it is only used where the header exists.

musl does not ship sys/cdefs.h, so utils/gcc-attributes.h fails to compile:

  utils/gcc-attributes.h:7:10: fatal error: 'sys/cdefs.h' file not found

The header already stubs out every macro it wants from sys/cdefs.h ("Stub them
when unavailable"), so the include itself only needs to be conditional.

--- a/utils/gcc-attributes.h
+++ b/utils/gcc-attributes.h
@@ -4,7 +4,13 @@
 #ifndef GCC_ATTRIBUTES_H
 #define GCC_ATTRIBUTES_H
 
-#include <sys/cdefs.h>
+#ifdef __has_include
+# if __has_include(<sys/cdefs.h>)
+#  include <sys/cdefs.h>
+# endif
+#else
+# include <sys/cdefs.h>
+#endif
 
 /* These macros originate in sys/cdefs.h. Stub them when unavailable. */
 #ifndef __returns_nonnull
