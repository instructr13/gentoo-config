musl libc does not provide <execinfo.h> or backtrace()/backtrace_symbols_fd();
those are glibc/GNU extensions. Guard the optional crash-backtrace dump so
the daemon still builds and runs on musl, just without a backtrace in the
crash dump (same underlying musl-compat issue class as the has_rpmatch fix).
--- a/src/main.c
+++ b/src/main.c
@@ -2158,7 +2158,9 @@

 #include <termios.h>
 #include <unistd.h>
+#ifdef __GLIBC__
 #include <execinfo.h>
+#endif

 #define BACKTRACE_SIZE 1024
 #define MAPS_SIZE 8192
@@ -2208,6 +2210,7 @@
 static void
 write_backtrace (int output_fd)
 {
+#ifdef __GLIBC__
         void *addresses[BACKTRACE_SIZE];
         int number_of_addresses;

@@ -2220,6 +2223,9 @@
         backtrace_symbols_fd (addresses + BACKTRACE_FRAMES_TO_SKIP,
                               number_of_addresses - BACKTRACE_FRAMES_TO_SKIP,
                               output_fd);
+#else
+        write (output_fd, "backtrace: unavailable (non-glibc libc)\n", 41);
+#endif
 }

 static void
