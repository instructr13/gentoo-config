# Swift 5.10.1 only: swift-tools-support-core on musl.
#
# Every hunk is a case where upstream already has the right code but selects it
# with canImport(Musl), which is always false here because Swift 5.10 configures
# no MUSL SDK -- so Linux unconditionally takes the glibc branch.
#
# 1. TSCBasic/WritableByteStream.swift -- FILEPointer
#    musl leaves `struct _IO_FILE` incomplete, so FILE is not importable and
#    stdio handles arrive as OpaquePointer:
#      error: cannot find type 'FILE' in scope
#      error: cannot convert value of type 'OpaquePointer?' to 'AbsolutePath'
#    Android already uses exactly the OpaquePointer shape needed here.
#
# 2. TSCUtility/InterruptHandler.swift -- struct sigaction
#    glibc holds an anonymous union imported as __sigaction_handler; musl names
#    the member __sa_handler and reaches sa_handler through a macro Swift cannot
#    import:
#      error: value of type 'sigaction' has no member '__sigaction_handler'
#    Assigning the union member directly also removes the unsafeBitCast.
#
# 3. TSCUtility/FSWatch.swift -- fd_set
#    glibc calls the member __fds_bits, musl (like bionic) calls it fds_bits:
#      error: value of type 'fd_set' has no member '__fds_bits'
#    Four sites: FD_ZERO, FD_SET, and two helpers.
#
# 4. TSCUtility/{IndexStore,dlopen}.swift -- RTLD_DEEPBIND
#    A glibc extension with no musl equivalent:
#      error: cannot find 'RTLD_DEEPBIND' in scope
#    canImport(Glibc) cannot discriminate because the Swift overlay module is
#    named Glibc on musl too, so use 0 -- dlopen's default binding, already the
#    value every other non-glibc platform gets here.
#
# All hunks are musl-specific: a glibc build needs the original branches
# (item 4 would merely lose the deep-bind hint).

--- a/swift-tools-support-core/Sources/TSCBasic/WritableByteStream.swift
+++ b/swift-tools-support-core/Sources/TSCBasic/WritableByteStream.swift
@@ -66,7 +66,11 @@
 // Public alias to the old name to not introduce API compatibility.
 public typealias OutputByteStream = WritableByteStream
 
-#if os(Android) || canImport(Musl)
+// Upstream distinguishes musl with canImport(Musl), but Swift 5.10 configures no
+// MUSL SDK so that test is always false. musl leaves `struct _IO_FILE`
+// incomplete, so FILE is not importable and stdio handles arrive as
+// OpaquePointer -- the same shape Android already uses here.
+#if os(Android) || os(Linux) || canImport(Musl)
 public typealias FILEPointer = OpaquePointer
 #else
 public typealias FILEPointer = UnsafeMutablePointer<FILE>
--- a/swift-tools-support-core/Sources/TSCUtility/InterruptHandler.swift
+++ b/swift-tools-support-core/Sources/TSCUtility/InterruptHandler.swift
@@ -78,6 +78,12 @@
         action.__sigaction_u.__sa_handler = self.signalHandler
       #elseif os(Android)
         action.sa_handler = self.signalHandler
+      #elseif os(Linux)
+        // glibc's struct sigaction holds an anonymous union imported as
+        // __sigaction_handler; musl names the union member __sa_handler and
+        // reaches sa_handler through a macro, which Swift cannot import. Assign
+        // the union member directly -- no unsafeBitCast needed either.
+        action.__sa_handler.sa_handler = self.signalHandler
       #else
         action.__sigaction_handler = unsafeBitCast(
             self.signalHandler,
--- a/swift-tools-support-core/Sources/TSCUtility/FSWatch.swift
+++ b/swift-tools-support-core/Sources/TSCUtility/FSWatch.swift
@@ -621,7 +621,11 @@
