# compiler-rt components that assume glibc. Applies to both 5.10.1 and 6.3.3;
# upstream carries neither fix.
--- a/llvm-project/compiler-rt/lib/gwp_asan/optional/backtrace_linux_libc.cpp
+++ b/llvm-project/compiler-rt/lib/gwp_asan/optional/backtrace_linux_libc.cpp
@@ -7,7 +7,15 @@
 //===----------------------------------------------------------------------===//
 
 #include <assert.h>
+#if __has_include(<execinfo.h>)
 #include <execinfo.h>
+#define GWP_ASAN_HAS_EXECINFO 1
+#else
+// backtrace(3)/backtrace_symbols(3) are a glibc extension; musl has no
+// <execinfo.h>. Keep GWP-ASan (and therefore SCUDO) building there, just
+// without backtraces from this provider.
+#define GWP_ASAN_HAS_EXECINFO 0
+#endif
 #include <stddef.h>
 #include <stdint.h>
 #include <stdlib.h>
@@ -22,7 +30,13 @@
 size_t Backtrace(uintptr_t *TraceBuffer, size_t Size) {
   static_assert(sizeof(uintptr_t) == sizeof(void *), "uintptr_t is not void*");
 
+#if GWP_ASAN_HAS_EXECINFO
   return backtrace(reinterpret_cast<void **>(TraceBuffer), Size);
+#else
+  (void)TraceBuffer;
+  (void)Size;
+  return 0;
+#endif
 }
 
 // We don't need any custom handling for the Segv backtrace - the libc unwinder
@@ -40,8 +54,12 @@
     return;
   }
 
+#if GWP_ASAN_HAS_EXECINFO
   char **BacktraceSymbols =
       backtrace_symbols(reinterpret_cast<void **>(Trace), TraceLength);
+#else
+  char **BacktraceSymbols = nullptr;
+#endif
 
   for (size_t i = 0; i < TraceLength; ++i) {
     if (!BacktraceSymbols)
--- a/llvm-project/compiler-rt/lib/fuzzer/CMakeLists.txt
+++ b/llvm-project/compiler-rt/lib/fuzzer/CMakeLists.txt
@@ -160,2 +160,7 @@
     set(LIBCXX_${arch}_PREFIX ${CMAKE_CURRENT_BINARY_DIR}/libcxx_fuzzer_${arch})
+    if(COMPILER_RT_DEFAULT_TARGET_TRIPLE MATCHES "-musl")
+      set(FUZZER_LIBCXX_HAS_MUSL_LIBC ON)
+    else()
+      set(FUZZER_LIBCXX_HAS_MUSL_LIBC OFF)
+    endif()
     add_custom_libcxx(libcxx_fuzzer_${arch} ${LIBCXX_${arch}_PREFIX}
@@ -166,2 +176,3 @@
                  -DLIBCXX_ABI_NAMESPACE=__Fuzzer
+                 -DLIBCXX_HAS_MUSL_LIBC=${FUZZER_LIBCXX_HAS_MUSL_LIBC}
                  -DLIBCXX_ENABLE_EXCEPTIONS=OFF)
